{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vuepress/client-types"]
  },
  "include": ["site/theme/**/*.ts", "site/theme/**/*.vue", "site/types.d.ts"]
}
